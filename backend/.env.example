# ---------------------------------------------------------------
# EducaGen API (FastAPI) - copia este archivo como .env
# ---------------------------------------------------------------

# PostgreSQL (local con Docker o Supabase). Si se deja vacío se usa SQLite solo para pruebas.
DATABASE_URL=postgresql://educagen:educagen@localhost:5432/educagen

# Debe ser IGUAL al JWT_SECRET del frontend (.env.local)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_HORAS=8
COOKIE_SEGURA=false
CORS_ORIGENES=http://localhost:3000
APP_URL=http://localhost:3000

# Correo SMTP para recuperar contraseña (Gmail: usa una contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=

# Proveedores de IA: Gemini (principal) y Claude (respaldo)
# Sin claves la app funciona en modo demostración con plantillas locales.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
LLM_MODO=auto
LLM_TIMEOUT_SEG=60
LLM_REINTENTOS=3
CIRCUITO_FALLAS=3
CIRCUITO_ESPERA_SEG=60
MAX_TOKENS_SALIDA=12000

# Para demostrar HU0028/HU0029 sin claves:
#   LLM_SIMULAR_FALLA_PRINCIPAL=true  -> falla "Gemini" y responde el respaldo
#   LLM_SIMULAR_FALLA_TOTAL=true      -> fallan ambos y se guarda el borrador
LLM_SIMULAR_FALLA_PRINCIPAL=false
LLM_SIMULAR_FALLA_TOTAL=false

# Exportación
UNIVERSIDAD_NOMBRE=Universidad Peruana de Ciencias Aplicadas
MAX_RECURSOS=200
