# ---------------------------------------------------------------
# EducaGen API (FastAPI) - copia este archivo como .env
# ---------------------------------------------------------------

# PostgreSQL (local con Docker o Neon.tech / Supabase en producción). Si se deja vacío usa SQLite local.
DATABASE_URL=postgresql://educagen:educagen@localhost:5432/educagen

# Debe ser IGUAL al JWT_SECRET del frontend (.env.local / Vercel)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_HORAS=8
# En producción con HTTPS cambia COOKIE_SEGURA=true
COOKIE_SEGURA=false
CORS_ORIGENES=http://localhost:3000
APP_URL=http://localhost:3000

# Cuenta institucional de demostración sembrada al iniciar
CREAR_USUARIO_DEMO=true
DEMO_CORREO=demo@universidad.edu.pe
DEMO_CONTRASENA=EducaGenDemo2026!

# Verificación de correo al registrarse (true por defecto)
REQUERIR_VERIFICACION_CORREO=true

# Opción 1 de Correo (Recomendada en Render / Hugging Face Spaces: HTTPS puerto 443 vía Google Apps Script)
CORREO_WEBHOOK_URL=
CORREO_WEBHOOK_SECRET=

# Opción 2 de Correo (Koyeb / Local / VPS con puerto 587 abierto: Gmail con Contraseña de Aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=

# Proveedores de IA gratuitos: Groq (principal) + Google Gemini (respaldo automático), o Claude opcional.
# Sin claves la app funciona en modo demostración con plantillas locales.
GROQ_API_KEY=
LLAMA_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
LLM_MODO=auto
LLM_TIMEOUT_SEG=60
LLM_REINTENTOS=3
CIRCUITO_FALLAS=3
CIRCUITO_ESPERA_SEG=60
MAX_TOKENS_SALIDA=12000

# Para demostrar HU0028/HU0029 sin claves:
#   LLM_SIMULAR_FALLA_PRINCIPAL=true  -> falla el principal y responde el respaldo
#   LLM_SIMULAR_FALLA_TOTAL=true      -> fallan ambos y se guarda el borrador
LLM_SIMULAR_FALLA_PRINCIPAL=false
LLM_SIMULAR_FALLA_TOTAL=false

# Exportación
UNIVERSIDAD_NOMBRE=Universidad Peruana de Ciencias Aplicadas
MAX_RECURSOS=200
